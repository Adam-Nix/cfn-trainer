# Copy to .env (git-ignored). Never commit real passwords.
TRAINER_HOST=cfn.adamnix.com
# name:password pairs, comma separated. Use TRAINER_USERS_FILE instead if a password contains a comma.
TRAINER_USERS=alice:change-me-1,bob:change-me-2
# Behind a reverse proxy / Cloudflare Tunnel, so rate limiting sees the real client IP:
TRAINER_TRUST_PROXY=1
# TRAINER_MAX_JOBS=2
